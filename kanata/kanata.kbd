;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a s d f g h j k l ;
)
(defvar
  tap-time 150
  hold-time 200
)

(defalias
  ;; escctrl (tap-hold 100 100 esc lctl)
  a (multi (tap-hold $tap-time $hold-time a lmet))
  s (multi (tap-hold $tap-time $hold-time s lalt))
  d (multi (tap-hold $tap-time $hold-time d lsft))
  f (multi (tap-hold $tap-time $hold-time f lctl))
  j (multi (tap-hold $tap-time $hold-time j rctl))
  k (multi (tap-hold $tap-time $hold-time k rsft))
  l (multi (tap-hold $tap-time $hold-time l ralt))
  ; (multi (tap-hold $tap-time $hold-time ; rmet))
  ;; tap g = g, hold g = vim-style arrow layer
  g (tap-hold $tap-time $hold-time g (layer-while-held nav))
)


(deflayer base
  esc @a @s @d @f @g h @j @k @l @;
)

;; active while g is held: hjkl -> arrows (home-row mods on a/s/d/f still work)
(deflayer nav
  _ _ _ _ _ _ left down up right _
)

;; spc


