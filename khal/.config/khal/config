# Calendars are synced by vdirsyncer into ~/.local/share/calendars/<name>/
# Each subfolder is picked up automatically, with its server color/name.

[calendars]
  [[mailinabox]]
    path = ~/.local/share/calendars/*
    type = discover

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[default]
highlight_event_days = True
